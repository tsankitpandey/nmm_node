<%- contentFor('body') %>
<section class="content">
	<div class="container-fluid">
		<div class="row">
			<div class="col-md-12">
				<div class="card card-theme card-outline shadow-sm">
					<div class="card-header d-none">
						<h4 class="card-title mb-3">Membership Request List</h4>
					</div>

                    <div class="card-body">
                        <div class="row">
                            <hr class="mb-3">
                            <div class="table-responsive mb-3">
                                <table  id="example2" class=" display table table-striped table-bordered mb-5">
                                    <thead class="mb-2 border-1">
                                        <tr>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Contact</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (request.request && request.request.length > 0) { %>
                                            <% request.request.forEach((requests) => { %>
                                                <!-- <pre><%= JSON.stringify(requests,null,2) %></pre> -->
                                        <tr>
                                            <td><%= requests.first_name %></td>
                                            <td><%= requests.email %> </td>
                                            <td><%= requests.contact %></td>
                                            <td>   
                                            <button type="button" class="btn btn-sm btn-success confirm-box" 
                                                data-route="<%= AdminRoute(`/Approve?id=${requests.id}`) %>" 
                                                data-tooltip="Approve" 
                                                data-title="Membership Approve" 
                                                data-content="Are you sure you want to approve the membership..?" 
                                                data-type="success">
                                                <i class='bx bxs-calendar'></i>
                                            </button>

                                            <button type="button" class="btn btn-sm btn-danger confirm-box" data-route="<%= AdminRoute(`/RequestDelete?id=${requests.id}`) %>" data-tooltip="Delete" data-title="Member Remove" data-content="Are you sure want to delete this news!" data-type="red">
                                                <i class='bx bxs-trash' ></i>
                                            </button>

                                           </td>
                                        </tr>
                                        <% }); %>
                                    <% }  %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
				</div>
			</div>
		</div>
	</div>
</section>

