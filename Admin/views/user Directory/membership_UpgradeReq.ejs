<%- contentFor ('body') %>

<section class="content">
	<div class="container-fluid">
		<div class="row">
			<div class="col-md-12">
				<div class="card card-theme card-outline shadow-sm">
					<div class="card-header d-none">
						<h4 class="card-title mb-3">Membership Upgrade Request List</h4>
					</div>

                    <div class="card-body">
                        <div class="row">
                            <hr class="mb-3">
                            <div class="table-responsive mb-3">
                                <table  id="example2" class=" display table table-striped table-bordered mb-5">
                                    <thead class="mb-2 border-1">
                                        <tr>
                                            <th>Company Name</th>
                                            <th>Old Membership</th>
                                            <th>Upgrade Membership</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (Upgrade && Upgrade.length > 0) { %>
                                            <% Upgrade.forEach((Upgrades) => { %>
                                                <!-- <pre><%= JSON.stringify(Upgrades,null,2) %></pre> -->
                                        <tr>
                                            <td><%= Upgrades.company_name %></td>
                                            <td>
                                                <% 
                                                  const memberPlan = Upgrades.member_plan; 
                                                  const planParts = memberPlan.split(':');
                                                  const planId = planParts[0];
                                                  const plan = planParts[1]; 
                                                %>
                                                <%= plan %>
                                              </td>
                                            <td><% const newPlan = Upgrades.membership_id;
                                                const planPart =  newPlan.split(':'); 
                                                const newplanId = planParts[0];
                                                const Newplan = planPart[1]; %>
                                                <%= Newplan %></td>
                                            <td>   
                                            <button type="button" class="btn btn-sm btn-success confirm-box" 
                                                data-route="<%= AdminRoute(`/UpgradeApprove?id=${Upgrades.id}`) %>" 
                                                data-tooltip="Approve" 
                                                data-title="Membership Upgrade" 
                                                data-content="Are you sure you want to approve the membership..?" 
                                                data-type="success">
                                                <i class='bx bxs-calendar'></i>
                                            </button>

                                            <button type="button" class="btn btn-sm btn-danger confirm-box" data-route="<%= AdminRoute(`/UpgradeReject?id=${Upgrades.id}`) %>" data-tooltip="Delete" data-title="Membership Reject" data-content="Are you sure want to Reject this Membership Upgrade!" data-type="red">
                                                <i class='bx bxs-calendar-x' ></i>
                                            </button>

                                           </td>
                                        </tr>
                                        <% }); %>
                                    <% }  %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
				</div>
			</div>
		</div>
	</div>
</section>