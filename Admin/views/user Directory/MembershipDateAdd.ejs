<%- contentFor('body') %>

<div class="modal-content">
  <div class="modal-header">
    <h4 class="card-title">Membership Date</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>
  <div class="modal-body">
    <div class="card">
      <div class="card-body border border-1 rounded-3">
        <form 
          class="needs-validation" 
          action="<%= AdminRoute('/DateUpdate') %>" 
          method="POST" 
          enctype="multipart/form-data" 
          novalidate
        >
          <input type="hidden" name="RequestId" value="<%= MemberShipDates.id %>">

          <div class="row">
            <div class="col-xl-6 col-md-6">
              <div class="form-group">
                <label class="mb-2">Membership Since Date <span class="text-danger">*</span></label>
                <input 
                  type="date" 
                  name="membership_since" 
                  class="form-control" 
                  placeholder="Membership Since Date" 
                  value="<%= MemberShipDates.membership_since %>" 
                  required
                />
                <div class="invalid-feedback">
                  Please select the Since Date.
                </div>
              </div>
            </div>

            <div class="col-xl-6 col-md-6">
              <div class="form-group">
                <label class="mb-2">Membership Start Date <span class="text-danger">*</span></label>
                <input 
                  type="date" 
                  name="membership_start" 
                  class="form-control" 
                  placeholder="Membership Start Date" 
                  value="<%= MemberShipDates.membership_start %>" 
                  required
                />
                <div class="invalid-feedback">
                  Please select the Start Date.
                </div>
              </div>
            </div> 

            <div class="col-xl-6 col-md-6">
              <div class="form-group">
                <label class="mb-2">Membership End Date <span class="text-danger">*</span></label>
                <input 
                  type="date" 
                  name="membership_expire" 
                  class="form-control" 
                  placeholder="Membership End Date" 
                  value="<%= MemberShipDates.membership_expire %>" 
                  required
                />
                <div class="invalid-feedback">
                  Please select the End Date.
                </div>
              </div>
            </div>
          </div>

          <hr />
          <div class="form-group mb-3">
            <button type="submit" class="btn btn-dark">Submit</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
