<%- contentFor('body') %> <%- contentFor('body') %>

<div class="modal-content">
  <!-- Modal Header -->
  <div class="modal-header bg-dark text-white">
    <h4 class="card-title text-white"> <i class="bx bx-comment-detail"></i> Comments</h4>
    <button
      type="button"
      class="btn-close btn-close-white"
      data-bs-dismiss="modal"
      aria-label="Close"
    ></button>
  </div>

  <!-- Modal Body -->
  <div class="modal-body">
    <!-- Member Profile -->
             <!-- <%= JSON.stringify(selectedFeed) %> -->
    <div class="d-flex align-items-center mb-3">
      <img
        src="https://media.istockphoto.com/id/2152939474/photo/mature-man-contemplating-on-balcony-at-home.jpg?s=2048x2048&w=is&k=20&c=C-GkDF-ONBKEzwbTlr2zwMa6_k4NI8K2xJkJjtzxYlE="
        alt="Member Logo"
        class="rounded-circle border me-3"
        width="50"
        height="50"
      />
      <div>
        <h5 class="mb-0">Ankit pandey</h5>
        <small class="text-muted">Posted 2 hours ago</small>
      </div>
    </div>

    <!-- Comment Section Layout -->
    <div class="row">
      <!-- Left Side: Image -->
      <div class="col-md-6">
        <div class="position-relative">
          <% if (selectedFeed.file_extension == "photo") { %>
            <img src="<%= selectedFeed.file_url.replace('/thumb', '') %>" alt="Post Image"
                class="w-100 mb-3" style="max-height: 500px; object-fit: contain;" />
        <% } else if (selectedFeed.file_extension == "audio") { %>
            <audio controls class="w-100 mb-3">
                <source src="<%= selectedFeed.file_url.replace('/thumb', '') %>" type="audio/mpeg">
                Your browser does not support the audio element.
            </audio>
        <% } else if (selectedFeed.file_extension == "video") { %>
            <video controls class="w-100 mb-3" style="max-height: 500px; object-fit: contain;">
                <source src="<%= selectedFeed.file_url.replace('/thumb', '') %>" type="video/mp4">
                Your browser does not support the video tag.
            </video>
        <% } %>
        </div>
      </div>

      <!-- Right Side: Comments List -->
      <div class="col-md-6">
        <div class="card border-0 shadow-sm p-3">
          <h6 class="mb-5 border-bottom border-dark">
            <i class="bx bx-comment-detail"></i> Comments
          </h6>
          <% if (timelineComment && timelineComment.length > 0) { %> 
            <div class="overflow-auto" style="max-height: 300px">
              <% timelineComment.forEach(comment => { %>
                <div class="d-flex align-items-start mb-3">
                  <img
                  src="https://media.istockphoto.com/id/2152939474/photo/mature-man-contemplating-on-balcony-at-home.jpg?s=2048x2048&w=is&k=20&c=C-GkDF-ONBKEzwbTlr2zwMa6_k4NI8K2xJkJjtzxYlE="
                    class="rounded-circle border me-2"
                    width="40"
                    height="40"
                  />
                  <div>
                    <strong><%= comment.member_name ? comment.member_name : 'Ankit pandey' %></strong>
                    <p class="mb-1 text-muted small"><%= comment.comment %></p>
                    <small class="text-muted"><%= new Date(comment.created_at * 1000).toLocaleString() %></small>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-muted text-center">No comments yet.</p>
          <% } %>
          

         
        </div>
      </div>
    </div>

    <!-- Comment Input Box -->
    <form action="/commentinsert" method="POST" enctype="multipart/form-data">
    <div class="mt-4">
      <div class="d-flex align-items-center">
        <img
          src="https://media.istockphoto.com/id/2152939474/photo/mature-man-contemplating-on-balcony-at-home.jpg?s=2048x2048&w=is&k=20&c=C-GkDF-ONBKEzwbTlr2zwMa6_k4NI8K2xJkJjtzxYlE="
          alt="User Avatar"
          class="rounded-circle border me-2"
          width="40"
          height="40"
        />
       
        <textarea
          class="form-control rounded-pill w-100"
          placeholder="Write a comment..."
          name="comment"
          rows="1"
        ></textarea>
        <input type="hidden" id="id" name="post_id" value="<%= selectedFeed.id %>">
        <input type="hidden" id="memberId" name="member_id" value="">
        <input type="hidden" id="companyId" name="company_id" value="">


        <button class="btn btn-primary ms-2" type="submit">
          <i class="bx bx-send"></i>
        </button>
      </form>
      </div>
    </div>
  </div>
</div>
