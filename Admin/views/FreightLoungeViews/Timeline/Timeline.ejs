<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fixed Timeline & News</title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <style>
        .news-container {
            position: fixed;
            right: 0;
            max-height: calc(80vh - 60px);
            overflow-y: auto;
            padding-left: 15px;
            padding-right: 15px;
            background-color: #f9f9f9;
        }

        .timeline-container {
            position: fixed;
            max-height: calc(100vh - 60px);
            overflow-y: auto;
            background-color: #f9f9f9;
        }

        .row {
            margin-left: 0;
            margin-right: 0;
        }


        input[type="file"] {
            display: none;
        }

        .preview-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-top: 10px;
            position: relative;
            background-color: #fff;
        }

        .preview-container img,
        .preview-container video {
            max-width: 100%;
            max-height: 200px;
            object-fit: cover;
        }

        .preview-container .remove-preview {
            position: absolute;
            top: 5px;
            right: 5px;
            background: rgb(206, 9, 9);
            color: white;
            border: none;
            border-radius: 5px;
            padding: 5px;
            cursor: pointer;
        }
    </style>
</head>

<body>

    <div class="container-fluid mt-5">
        <!-- <%= JSON.stringify(feeds) %> -->

        <div class="row">
            <div class="mb-5 d-flex justify-content-between">
                <!-- Timeline Section -->
                <div class="col-md-6 col-xl-6 col-sm-7   timeline-container mb-5">
                    <form action="<%=AdminRoute('/insert') %>" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <textarea class="form-control" name="textarea" id="postText" rows="3"
                                placeholder="What's on your mind?"></textarea>
                        </div>
                        <input type="hidden" id="memberId" name="member_id" value="">
                        <input type="hidden" id="companyId" name="company_id" value="">

                        <div class="d-flex justify-content-between">
                            <div class="mb-3">
                                <button class="btn btn-outline-secondary btn-sm me-2" id="addPhotoBtn" type="button">
                                    <i class="bx bx-image"></i> Add Photo
                                </button>

                                <input type="file" id="photoInput" name="photo" accept="image/*" />

                                <button class="btn btn-outline-secondary btn-sm me-2" id="addVideoBtn" type="button">
                                    <i class="bx bx-video"></i> Add Video
                                </button>
                                <!-- Hidden file input for video -->
                                <input type="file" id="videoInput" name="video" accept="video/*" />

                                <button class="btn btn-outline-secondary btn-sm" id="addMusicBtn" type="button">
                                    <i class="bx bx-music"></i> Add Music
                                </button>
                                <!-- Hidden file input for music -->
                                <input type="file" id="musicInput" name="music" accept="audio/*" />
                            </div>

                            <div class="mb-3">
                                <button type="submit" class="btn btn-primary" id="postButton">
                                    <i class="bx bx-paper-plane"></i> Post
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- File preview section -->
                    <div id="previewContainer" class="preview-container"></div>



                    <!-- Timeline Posts (Scrollable) -->
                    <ul class="list-group mb-5">
                        <% feeds.feeds.map(feed => { %>
                            <li class="list-group-item mb-5">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <!-- User Info -->
                                    <div class="d-flex align-items-center">
                                        <img src="https://media.istockphoto.com/id/2152939474/photo/mature-man-contemplating-on-balcony-at-home.jpg?s=2048x2048&w=is&k=20&c=C-GkDF-ONBKEzwbTlr2zwMa6_k4NI8K2xJkJjtzxYlE="
                                            alt="<%= feed.user %>'s logo" class="rounded-circle"
                                            style="width: 40px; height: 40px; object-fit: cover;" />
                                        <strong class="ms-3 fs-6">Ankit Sharma || Techsimba Pvt Ltd</strong>
                                    </div>
                    
                                    <!-- Three Dots Dropdown -->
                                    <div class="dropdown">
                                        <button class="btn btn-light btn-sm" type="button" id="dropdownMenuButton<%= feed.id %>" 
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bx bx-dots-horizontal-rounded fs-4"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuButton<%= feed.id %>">
                                           
                                            <li> <button class="btn btn-light btn-sm w-100 comment-btn" data-route="<%= AdminRoute('/feedsedit/' + feed.id) %>"
                                                data-bs-toggle="modal" data-bs-target="#form-modal">
                                                <i class="bx bx-edit" ></i>  <span class="d-none d-md-inline">Edit</span>
                                            </button></li>
                                            <li> <a class="btn btn-light btn-sm w-100 " href="<%= AdminRoute('/feedsdelete/' +feed.id) %>">
                                                <i class="bx bx-trash"></i> <span class="d-none d-md-inline">Delete</span>
                                            </a></li>
                                        </ul>
                                    </div>
                                </div>
                    
                                <!-- Post Time -->
                                <span class="text-muted float-center ms-5">
                                    <%= new Date(feed.created_at * 1000).toLocaleString() %>
                                </span>
                    
                                <!-- Post Content -->
                                <p class="mt-4 mb-2">
                                    <%= feed.textarea %>
                                </p>
                    
                                <!-- File Display -->
                                <% if (feed.file_extension == "photo") { %>
                                    <img src="<%= feed.file_url.replace('/thumb', '') %>" alt="Post Image"
                                        class="w-100 mb-3" style="max-height: 500px; object-fit: contain;" />
                                <% } else if (feed.file_extension == "audio") { %>
                                    <audio controls class="w-100 mb-3">
                                        <source src="<%= feed.file_url.replace('/thumb', '') %>" type="audio/mpeg">
                                        Your browser does not support the audio element.
                                    </audio>
                                <% } else if (feed.file_extension == "video") { %>
                                    <video controls class="w-100 mb-3" style="max-height: 500px; object-fit: contain;">
                                        <source src="<%= feed.file_url.replace('/thumb', '') %>" type="video/mp4">
                                        Your browser does not support the video tag.
                                    </video>
                                <% } %>
                    
                                <!-- Like, Comment, Share Buttons -->
                                <div class="d-flex justify-content-between align-items-center mt-1 mb-5">
                                    <div class="btn-group" role="group">
                                        <button class="btn btn-light btn-sm like-btn">
                                            <i class="bx bx-like"></i> <span class="d-none d-md-inline">Like</span>
                                        </button>
                                        <button class="btn btn-light btn-sm comment-btn" data-route="<%= AdminRoute('/comment/' + feed.id) %>"

                                            data-bs-toggle="modal" data-bs-target="#form-modal">
                                            <i class="bx bx-comment"></i> <span class="d-none d-md-inline">Comment</span>
                                        </button>
                                        <button class="btn btn-light btn-sm share-btn">
                                            <i class="bx bx-share-alt"></i> <span class="d-none d-md-inline">Share</span>
                                        </button>
                                    </div>
                                </div>
                            </li>
                        <% }); %>
                    </ul>
                    
                </div>

                <!-- News Section -->
                <div class="col-md-3 offset-md-1 news-container">
                    <div class="card">
                        <h3 class="mb-3 text-center p-3">News</h3>
                    </div>

                    <% news.forEach(news=> { %>
                        <div class="card mb-3">
                            <% if (news.image) { %>
                                <img src="<%= news.image.replace('/thumb', '') %>" class="card-img-top"
                                    alt="<%= news.title %>"
                                    style="max-height: 200px; width: 100%; object-fit: contain;">
                                <% }%>
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <%= news.title %>
                                        </h5>
                                        <p class="card-text">
                                            <%= news.description %>
                                        </p>
                                        <a href="<%= news.link %>" class="btn btn-secondary text-center">
                                            <i class="bx bx-book-reader"></i> Read More
                                        </a>
                                    </div>
                        </div>
                        <% }); %>
                </div>

            </div>
        </div>

        <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
        <script src="/public/assets/js/custom.js"></script>



</body>

</html>