<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Timeline & News</title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
</head>
<body>

<div class="container mt-5">
    <div class="row">
       
        <div class="col-md-8">

        
           
            <div class="mb-3">
                <textarea class="form-control" id="postText" rows="3" placeholder="What's on your mind?"></textarea>
            </div>
        
          
            <div class="d-flex justify-content-between">
            <div class="mb-3">
                <button class="btn btn-outline-primary btn-sm me-2" id="addPhotoBtn">
                    <i class="bx bx-image"></i> Add Photo
                </button>
                <button class="btn btn-outline-secondary btn-sm me-2" id="addVideoBtn">
                    <i class="bx bx-video"></i> Add Video
                </button>
                <button class="btn btn-outline-success btn-sm" id="addMusicBtn">
                    <i class="bx bx-music"></i> Add Music
                </button>
            </div>
        
          
            <div class="mb-3">
                <button class="btn btn-primary" id="postButton">
                    <i class="bx bx-paper-plane"></i> Post
                </button>
            </div>

        </div>
        
          
            <ul class="list-group mb-3">
                <% timelineFeeds.forEach(feed => { %>
                    <li class="list-group-item mb-3">
                        <div class="d-flex align-items-center mb-3">
                            <img src="<%= feed.user_logo %>" alt="<%= feed.user %>'s logo" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                            <strong class="ms-2"><%= feed.user %></strong>
                        </div>
                
                       
                        <p><%= feed.post %></p>
                
                       
                        <% if (feed.post_image) { %>
                            <img src="<%= feed.post_image %>" alt="Post Image" class="w-100 mb-3" style="max-height: 400px; object-fit: cover;" />
                        <% } %>
                
                        <span class="text-muted float-end"><%= feed.time %></span>
                
                      
                        <div class="mt-3">
                            <button class="btn btn-outline-primary btn-sm me-2">
                                <i class="bx bx-like"></i> Like
                            </button>
                            <button class="btn btn-outline-secondary btn-sm me-2">
                                <i class="bx bx-comment"></i> Comment
                            </button>
                            <button class="btn btn-outline-success btn-sm">
                                <i class="bx bx-share-alt"></i> Share
                            </button>
                        </div>
                    </li>
                <% }); %>
            </ul>
        </div>
        
        
        

        
        <div class="col-md-3 offset-md-1">
            <div class=" card"> <h3 class="  mb-3 text-center p-3">News</h3></div>
           
            <% newsCards.forEach(news => { %>
                <div class="card mb-3">
                
                    <img src="<%= news.image %>" class="card-img-top" alt="<%= news.title %>" style="max-height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title"><%= news.title %></h5>
                        <p class="card-text"><%= news.description %></p>
                        <a href="<%= news.link %>" class="btn btn-secondary text-center"> <i class="bx bx-book-reader"></i> Read More</a>
                    </div>
                </div>
            <% }); %>
        </div>
        
        
    </div>
</div>


<script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
