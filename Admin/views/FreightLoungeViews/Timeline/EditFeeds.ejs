<div class="modal-content">
    <!-- Modal Header -->
    <div class="modal-header bg-dark text-white">
      <h4 class="card-title text-white">
        <i class="bx bx-edit"></i> Edit Feed
      </h4>
      <button
        type="button"
        class="btn-close btn-close-white"
        data-bs-dismiss="modal"
        aria-label="Close"
      ></button>
    </div>
  
    <!-- Modal Body -->
    <div class="modal-body">
      <form action="/updatetimeline/<%= selectedFeed.id %>" method="POST" enctype="multipart/form-data">
      
        <input type="hidden" name="feedId" value="<%= selectedFeed.id %>" />
  
        <div class="d-flex align-items-center mb-3">
          <img
            src="https://media.istockphoto.com/id/2152939474/photo/mature-man-contemplating-on-balcony-at-home.jpg?s=2048x2048&w=is&k=20&c=C-GkDF-ONBKEzwbTlr2zwMa6_k4NI8K2xJkJjtzxYlE="
            alt="Member Logo"
            class="rounded-circle border me-3"
            width="50"
            height="50"
          />
          <div>
            <h5 class="mb-0">John Doe</h5>
            <small class="text-muted">Posted   <%= new Date(selectedFeed.created_at * 1000).toLocaleString() %> ago</small>
          </div>
        </div>
    
        <!-- Image Display (Fixed height without cropping) -->
        <div class="position-relative mb-3">
          <% if (selectedFeed.file_extension == "photo") { %>
              <img src="<%= selectedFeed.file_url.replace('/thumb', '') %>" alt="Post Image"
                  class="w-100 mb-3" style="max-height: 500px; object-fit: contain;" />
          <% } else if (selectedFeed.file_extension == "audio") { %>
              <audio controls class="w-100 mb-3">
                  <source src="<%= selectedFeed.file_url.replace('/thumb', '') %>" type="audio/mpeg">
                  Your browser does not support the audio element.
              </audio>
          <% } else if (selectedFeed.file_extension == "video") { %>
              <video controls class="w-100 mb-3" style="max-height: 500px; object-fit: contain;">
                  <source src="<%= selectedFeed.file_url.replace('/thumb', '') %>" type="video/mp4">
                  Your browser does not support the video tag.
              </video>
          <% } %>
        </div>
    
        <!-- Textarea for Editing Feed -->
        <div class="mb-3">
          <textarea
            class="form-control"
            placeholder="Edit your feed..."
            rows="5"
            name="textarea"                                               
          >
            <%= selectedFeed ? selectedFeed.textarea : "" %>
          </textarea>
        </div>
    
        <!-- Submit Button -->
        <div class="d-flex justify-content-end">
          <button type="submit" class="btn btn-primary">
            <i class="bx bx-save"></i> Save Changes
          </button>
        </div>
      </form>
    </div>
</div>
