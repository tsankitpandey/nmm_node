<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat Page</title>

    <style>
      
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f4f7fc;
        }

        .sidebar {
            background: linear-gradient(145deg, #464545, #212529);
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        .sidebar .user-profile {
            background-color: #ffffff;
            padding: 8px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            transition: transform 0.3s ease;
        }

        .sidebar .user-profile:hover {
            transform: scale(1.05);
        }

        .sidebar .user-profile img {
            border-radius: 50%;
            margin-right: 20px;
            box-shadow: 0 0 5px rgba(0, 0, 0, 0.15);
        }

        .sidebar .user-profile h5 {
            margin: 0;
            color: #141313;
            font-weight: bold;
        }

        .sidebar .search-bar input {
            border-radius: 25px;
            padding-left: 20px;
            transition: all 0.3s ease;
        }

        .sidebar .search-bar input:focus {
            outline: none;
            border-color: #007bff;
        }

        .sidebar .nav-buttons button {
            border-radius: 30px;
            padding: 10px 18px;
            margin-top: 10px;
            transition: background-color 0.3s ease;
        }

        .sidebar .nav-buttons button:hover {
            background-color: #007bff;
            color: #fff;
        }

        .sidebar .list-group-item {
            border: none;
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 12px;
            background-color: #f8f9fa;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
            transition: background-color 0.3s ease;
        }

        .sidebar .list-group-item:hover {
            background-color: #e9ecef;
            cursor: pointer;
        }

        .chat-window {
            background-color: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            padding: 30px;
            height: 70vh;
            overflow-y: auto;
        }

        .chat-window .message {
            margin-bottom: 20px;
        }

        .chat-window .message .sender {
            font-weight: bold;
            margin-bottom: 5px;
            color: #333;
        }

        .chat-window .message .text {
            background-color: #eff2f5;
            padding: 12px 18px;
            border-radius: 18px;
            max-width: max-content
            ;
            word-wrap: break-word;
        }

        .chat-window .message.receiver .text {
            background-color: #dcedff;;
          
            margin-left: auto;
        }

        .chat-window .message.sender .text {
            background-color: #f1f1f1;
            color: #333;
        }

        .sidebar .list-group {
            margin-bottom: 20px;
        }
    </style>
</head>

