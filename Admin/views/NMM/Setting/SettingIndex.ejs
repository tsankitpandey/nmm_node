<%- contentFor('body') %>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-theme card-outline shadow-sm">
                    <div class="card-header">
                        <h4 class="card-title mb-3">Manage Settings</h4>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <ul class="nav nav-tabs" id="settingsTab">
                                <li class="nav-item">
                                    <a class="nav-link active" data-bs-toggle="tab" href="#general">General</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#account">Account</a>
                                </li>
                            </ul>
                        </div>
                        <div class="tab-content mt-3">
                            <!-- General Tab -->
                             <!-- <pre><%= JSON.stringify(settings,null,2) %></pre> -->
                            <div class="tab-pane fade show active" id="general">
                                <form class="g-3 needs-validation form-submit" action="/emailUpdate/<%= settings.id %>" method="post" enctype="multipart/form-data" novalidate>
                                    <div class="mx-3">
                                        <div class="row mb-3">
                                            <div class="col-6">
                                                <label>Auto Expire <span class="text-danger">*</span></label>
                                                <div class="form-check form-check-inline mx-5">
                                                    <input class="form-check-input" type="radio" name="auto_expire" id="inlineRadio1" value="no" <%= settings.auto_expire === 'no' ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="inlineRadio1">No</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="auto_expire" id="inlineRadio2" value="yes" <%= settings.auto_expire === 'yes' ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="inlineRadio2">Yes</label>
                                                </div>
                                            </div>                                                                                    
                                        </div>
                                        <div class="row mb-4">
                                            <div class="col-4">
                                                <label>Welcome Email Template <span class="text-danger">*</span></label>
                                            </div>
                                            <div class="col-4">
                                                <select class="form-control" name="welcome_email_template" placeholder="Welcome Email Template">
                                
                                                    <% email.forEach(eml => { %>
                                                        <option value="<%= eml.add_email_id %>" <%= eml.title === settings.welcome_email_template ? 'selected' : '' %> >
                                                            <%= eml.title %>
                                                        </option>
                                                    <% }); %>
                                                </select>
                                                
                                            </div>
                                            <div class="col-4">
                                                <button class="btn btn-primary" data-route="<%= AdminRoute('/CustomAdd') %>" data-bs-toggle="modal" data-bs-target="#form-modal">
                                                    <i class='bx bx-edit'></i> Add Email Template
                                                </button>
                                            </div>
                                        </div>
                                        <div class="row mb-4">
                                            <div class="col-4">
                                                <label>Active User Email Template <span class="text-danger">*</span></label>
                                            </div>
                                            <div class="col-4">
                                                <select class="form-control" name="active_user_email_template" placeholder="Active User Email Template">
                                                    <option value="">Template</option>
                                                    <% email.forEach(eml => { %>
                                                        <option value="<%= eml.add_email_id %>" <%= eml.title === settings.active_user_email_template ? 'selected' : '' %> >
                                                            <%= eml.title %>
                                                        </option>
                                                    <% }); %>
                                                </select>
                                                
                                            </div>
                                            <div class="col-4">
                                                <button class="btn btn-primary" data-route="<%= AdminRoute('/CustomAdd') %>" data-bs-toggle="modal" data-bs-target="#form-modal">
                                                    <i class='bx bx-edit'></i> Add Email Template
                                                </button>
                                            </div>
                                        </div>
                                        <div class="row mb-4">
                                            <div class="col-4">
                                                <label>Cancel Member Email Template <span class="text-danger">*</span></label>
                                            </div>
                                            <div class="col-4">
                                                <select class="form-control" name="cancle_member_email_template" placeholder="Concel Member Email Template">
                                                    <% email.forEach(eml => { %>
                                                        <option value="<%= eml.add_email_id %>" <%= eml.title === settings.cancle_member_email_template ? 'selected' : '' %> >
                                                            <%= eml.title %>
                                                        </option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                            <div class="col-4">
                                                <button class="btn btn-primary" data-route="<%= AdminRoute('/CustomAdd') %>" data-bs-toggle="modal" data-bs-target="#form-modal">
                                                    <i class='bx bx-edit'></i> Add Email Template
                                                </button>
                                            </div>
                                        </div>
                                        <div class="row mb-4">
                                            <div class="col-4">
                                                <label>Deactive User Email Template <span class="text-danger">*</span></label>
                                            </div>
                                            <div class="col-4">
                                                <select class="form-control" name="deactive_user_email_template" placeholder="Deactive User Email Template">
                                                    <option value="">Template</option>
                                                    <% email.forEach(eml => { %>
                                                        <option value="<%= eml.add_email_id %>" <%= eml.title === settings.deactive_user_email_template ? 'selected' : '' %> >
                                                            <%= eml.title %>
                                                        </option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                            <div class="col-4">
                                                <button class="btn btn-primary" data-route="<%= AdminRoute('/CustomAdd') %>" data-bs-toggle="modal" data-bs-target="#form-modal">
                                                    <i class='bx bx-edit'></i> Add Email Template
                                                </button>
                                            </div>
                                        </div>
                                        <div class="row mb-4">
                                            <div class="col-4">
                                                <label>Prospect Email Template <span class="text-danger">*</span></label>
                                            </div>
                                            <div class="col-4">
                                                <select class="form-control" name="prospect_email_template" placeholder="Prospect Email Template">
                                                    <option value="">Template</option>
                                                    <% email.forEach(eml => { %>
                                                        <option value="<%= eml.add_email_id %>" <%= eml.title === settings.prospect_email_template ? 'selected' : '' %> >
                                                            <%= eml.title %>
                                                        </option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                            <div class="col-4">
                                                <button class="btn btn-primary" data-route="<%= AdminRoute('/CustomAdd') %>" data-bs-toggle="modal" data-bs-target="#form-modal">
                                                    <i class='bx bx-edit'></i> Add Email Template
                                                </button>
                                            </div>
                                        </div>
                                        <div class="row mb-5">
                                            <div class="col-4">
                                                <label>Custom Email Template <span class="text-danger">*</span></label>
                                            </div>
                                            <div class="col-4">
                                                <select class="form-control" name="custom_email_template" placeholder="Custom Email Template">
                                                    <option value="">Template</option>
                                                    <% email.forEach(eml => { %>
                                                        <option value="<%= eml.add_email_id %>" <%= eml.title === settings.custom_email_template ? 'selected' : '' %> >
                                                            <%= eml.title %>
                                                        </option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                            <div class="col-4">
                                                <button class="btn btn-primary" data-route="<%= AdminRoute('/CustomAdd') %>" data-bs-toggle="modal" data-bs-target="#form-modal">
                                                    <i class='bx bx-edit'></i> Add Email Template
                                                </button>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                          <div class="col-12">
                                              <label>Auto Email Notification To Expiring Members <span class="text-danger">*</span></label>
                                              <div class="form-check form-check-inline mx-5">
                                                  <input class="form-check-input" type="radio" name="auto_email_expiring_members" id="inlineRadio2" value="no"<%= ('no', settings.auto_email_expiring_members === 'no' ? 'checked' : '' ); %> >
                                                  <label class="form-check-label" for="inlineRadio2">No</label>
                                              </div>
                                              <div class="form-check form-check-inline">
                                                  <input class="form-check-input" type="radio" name="auto_email_expiring_members" id="inlineRadio2" value="yes"<%= ('yes', settings.auto_email_expiring_members === 'yes' ? 'checked' : '') %>>
                                                  <label class="form-check-label" for="inlineRadio2">Yes</label>
                                              </div>
                                          </div>
                                      </div>
                                    </div>
                                    <hr>
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary float-end">Update</button>
                                    </div>
                                </form>
                            </div>
                            <!-- Account Tab (Placeholder) -->
                            <div class="tab-pane fade" id="account">
                                <!-- <pre><%= JSON.stringify(accounts,null,2) %></pre> -->
                                <form class="g-3 needs-validation form-submit" action="/AccountUpdate"   method="post" enctype="multipart/form-data" novalidate>
                                  <div class="mx-3">
                                    <div class="form-row">
                                      <div class="col-12">
                                          <div class="mb-4">
                                              <h6 class="d-block text-md text-bold mb-2">Account Details</h6>
                                              <hr>
                                          </div>
                                      </div>
                                    </div> 
                                    <div class="row">
                                    <input type="hidden" id="AccountId" name="AccountId" value="<%= accounts[0].id %>">    
                                  <div class="col-md-6 mb-3">
                                    <label for="inputName" class="form-label">Admin Name <span class="text-danger">*</span></label>
                                    <input type="text" name="admin_name" class="form-control" id="inputName" placeholder="Admin Name" value="<%= accounts[0].admin_name %>" required>
                                    <div class="invalid-feedback">Please enter a Admin Name.</div>
                                  </div>
                                  <div class="col-md-6 mb-3">
                                    <label for="inputEmail" class="form-label">Email <span class="text-danger">*</span></label>
                                    <input type="email" name="admin_email" class="form-control" id="inputEmail" placeholder="admin email" value="<%= accounts[0].admin_email %>" required>
                                    <div class="invalid-feedback">Please enter a Email.</div>
                                  </div>
                                  <div class="col-md-12 mb-3">
                                    <label for="inputAddress" class="form-label">Company Address <span class="text-danger">*</span></label>
                                    <textarea type="email" name="company_address" class="form-control" id="inputAddress" placeholder="company Address" value="<%= accounts[0].company_address %>" required><%= accounts[0].company_address %>
                                  </textarea>
                                    <div class="invalid-feedback">Please enter a address.</div>
                                  </div>
                                  <div class="col-md-6 mb-4">
                                    <label for="inputCompanyContact" class="form-label">Company Contact <span class="text-danger">*</span></label>
                                    <input type="text" name="company_contact" class="form-control" id="inputCompanyContact" placeholder="Admin Contact" value="<%= accounts[0].company_contact %>" required>
                                    <div class="invalid-feedback">Please enter a contact</div>
                                  </div>
                                  <div class="col-md-6 mb-4">
                                    <label for="inputCompanyName" class="form-label">Company Name <span class="text-danger">*</span></label>
                                    <input type="text" name="company_name" class="form-control" id="inputCompanyName" placeholder="Company Name" value="<%= accounts[0].company_name %>" required>
                                    <div class="invalid-feedback">Please enter a Company Name.</div>
                                  </div>
                                  <div class="col-md-6 mb-4">
                                    <label for="inputShortName" class="form-label">Company Short Name <span class="text-danger">*</span></label>
                                    <input type="text" name="company_short_name" class="form-control" id="inputShortName" placeholder="Short name" value="<%= accounts[0].company_short_name %>" required>
                                    <div class="invalid-feedback">Please enter a short name</div>
                                  </div>
                                  <div class="col-md-6 mb-4">
                                    <label for="inputTitle" class="form-label">Title <span class="text-danger">*</span></label>
                                    <input type="text" name="title" class="form-control" id="inputTitle" placeholder="title" value="<%= accounts[0].title %>" required>
                                    <div class="invalid-feedback">Please enter a Title.</div>
                                  </div>
                                  <div class="col-md-6 mb-4">
                                    <label for="inputFooterContent" class="form-label">Footer Content <span class="text-danger">*</span></label>
                                    <input type="text" name="footer_content" class="form-control" id="inputFooterContent" placeholder="Content" value="<%= accounts[0].footer_content %>" required>
                                    <div class="invalid-feedback">Please enter a short name</div>
                                  </div>
                                  <div class="col-md-6 mb-4">
                                    <label for="inputAmount" class="form-label">Footer Title <span class="text-danger">*</span></label>
                                    <input type="text" name="footer_title" class="form-control" id="inputAmount" placeholder="Footer title" value="<%= accounts[0].footer_title %>" required>
                                    <div class="invalid-feedback">Please enter a Title.</div>
                                  </div>
                                  <div class="col-md-6">
                                    <div class="form-group mb-4">
                                        <label>Profile Upload <span class="text-danger" style="font-size:smaller"> * (Image size must be 1300x200)</span> </label>
                                        <div class="form-file">
                                            <input type="file" class="form-control form-file-input w-100" name="profile" value="<%= accounts[0].profile %>" placeholder="Profile Upload" id="form-file" view="preview" required>
                                            <label class="form-file-label"></label>
                                        </div>
                                    </div>
                                    <div class="invalid-feedback">Please enter a image.</div>
                                </div>
                                <div class="col-md-6">
                                  <div class="form-group mb-4">
                                    <label>Company logo <span class="text-danger" style="font-size:smaller"> * (Image size must be 1300x200)</span> </label>
                                    <div class="form-file">
                                      <input type="file" class="form-control form-file-input w-100" name="company_logo" value="<%= accounts[0].company_logo %>" placeholder="Company logo" id="form-file" view="preview" required>
                                      <label class="form-file-label"></label>
                                    </div>
                                  </div>
                                    <div class="invalid-feedback">Please enter a image.</div>
                                  </div>
                                </div>
                              </div>
                                  <hr>
                                  <div class="col-12">
                                      <button type="submit" class="btn btn-primary float-end">Update</button>
                                  </div>
                              </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
