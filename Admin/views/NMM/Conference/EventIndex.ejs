<%- contentFor('body') %>
<section class="content">
	<div class="container-fluid">
		<div class="row">
			<div class="col-md-12">
				<div class="card card-theme card-outline shadow-sm">
					<div class="card-header">
						<h4 class="card-title mb-3">Conference Events </h4>

					</div>
					
                    <div class="card-body border-bottom">
    					<div class="row">
        					<div class="col-6 mb-3">
        						<a href="<%= AdminRoute('/EventAdd') %>" class="btn btn-sm btn-gradient-dark px-4 radius-30 float-lefty" >
                                     Add
								</a> 
						    </div>
                        <!-- <%= JSON.stringify(eventData) %> -->

							<hr>
							<div class="table-responsive">
								<table class="table table-bordered">
									<thead class="table-dark">
										<tr>
											<th>Event Title</th>
											<th>Event Name</th>
											<th>Country</th>
											<th>Timezone</th>
											<th>Status</th>
											<th>Start Date</th>
											<th>End Date</th>
											<th>Action</th>
										</tr>
									</thead>
									<tbody>
										<% if (eventData.data && eventData.data.length > 0) { %>
											<% eventData.data.forEach(event => { %>
												<tr>
													<td><%= event.Event_Title %></td>
													<td><%= event.Event_Name %></td>
													<td><%= event.Location.split(":")[1] %></td> 
													<td><%= event.timeZone %></td>
													<td><%= event.status %></td>
													<td>
														<i class="bx bx-calendar-alt me-2"></i>
														<%= new Date(event.start_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
													</td>
													<td>
														<i class="bx bx-calendar-alt me-2"></i>
														<%= new Date(event.end_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
													</td>
													<td>
														<a href="<%= AdminRoute('/EditEventConfrece/' + event.id) %>"
													    class="btn btn-primary btn-sm rounded-3">
															<i class="bx bx-edit"></i> Edit
														</a>
														<a href="/delete/<%= event.id %>" class="btn btn-danger btn-sm rounded-3">
															<i class="bx bx-trash"></i> Delete
														</a>
													</td>
												</tr>
											<% }) %>
										<% } else { %>
											<tr>
												<td colspan="8" class="text-center">No events found</td>
											</tr>
										<% } %>
									</tbody>
								</table>
							</div>
							
							
							
						</div>
        			</div>
				</div>
			</div>
		</div>
	</div>
</section>
