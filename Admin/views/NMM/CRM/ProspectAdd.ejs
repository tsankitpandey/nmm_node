<%- contentFor('body') %>
<%- contentFor('body') %>

<div class="modal-content">
    <div class="modal-header">
        	<h4 class="card-title ">Add Prospect </h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div class="card">
            <div class="card-body">
                <form class="g-3 form-submit" method="">
                    <div class="row ">
                    <div class="col-md-6 mb-3">
                        <label for="inputFirstName" class="form-label">Company Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="" class="form-label">Country <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="" class="form-label">Website <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="">
                    </div>
                </div>
                <hr class="horizone">
               
                <div class="form-content form-append p-2" data-limit="5">
                    <div class="form-container mt-4">
                        <div class="d-block border rounded my-2 px-2 py-0">
                            <div class="position-relative text-left" style="bottom: 8px;">
                                <span class="d-inline bg-theme border rounded px-2 py-1"><span class="text-bold">Attendee #<span class="form-title no-border"></span></span></span>
                            </div>
                            
                            <div class="position-relative text-left ml-3 mr-3">
                                <div class="form-row">
                                    <div class="col-md-12">
                                        <div class="row ">
                                            <div class="col-md-6 mb-3">
                                                <label for="inputFirstName" class="form-label">Attendees Name <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control" id="">
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="" class="form-label">Email <span class="text-danger">*</span></label>
                                                <input type="email" class="form-control" id="">
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="" class="form-label">Mobile  <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control" id="">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="position-relative text-right d-none" style="top: 8px;">
                                <span class="d-inline bg-white border rounded px-2 py-1"></span>
                            </div>
                        </div>
                    </div>
                </div>
            <div class="col-12">
                <button type="submit" class="btn btn-dark ">Submit</button>
            </div>
                </form>
            </div>
        </div>

	</div>
</div>	
