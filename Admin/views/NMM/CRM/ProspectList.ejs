<%- contentFor('body') %>
<section class="content">
	<div class="container-fluid">
		<div class="row">
			<div class="col-md-12">
				<div class="card card-theme card-outline shadow-sm">
					<div class="card-header">
						<h4 class="card-title mb-3">Prospect List</h4>
					</div>
					
                    <div class="card-body border-bottom">
    					<div class="row">
        					<div class="col-12">
        						<button type="button" class="btn btn-sm btn-gradient-dark radius-30 float-right mx-2" data-route="<%= AdminRoute('/ProspectAdd') %>" data-bs-toggle="modal" data-bs-target="#form-modal">
                                    <i class='bx bx-edit'></i> ADD
        						</button>
                                <button type="button" class="btn btn-sm btn-gradient-success radius-30 float-right" data-route="<%= AdminRoute('/sheetImport') %>" data-bs-toggle="modal" data-bs-target="#form-modal">
        						    <i class='bx bxs-file-export'></i>Import
        						</button>
						    </div>
						</div>
        			</div>

                    <div class="card-body"> 
                        <div class="table-responsive">
                            <table id="example" class="table table-striped table-bordered" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Country</th>
                                        <th>Email</th>
                                        <th>Entry Date</th>          
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                            </tbody>        
                            </table>
                        </div>
                    </div>
				</div>
			</div>
		</div>
	</div>
</section>
