<%- contentFor('body') %>
<%- contentFor('body') %>

<div class="modal-content">
    <div class="modal-header">
        	<h4 class="card-title ">Add</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div class="card">
            <div class="card-body border border-1 rounded-3">
                <form class="row g-3" method="">
                    <div class="col-md-6">
                        <label for="inputFirstName" class="form-label">Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="">
                    </div>
                    <div class="col-md-6">
                        <label for="" class="form-label">Priority <span class="text-danger">*</span></label>
                        <select class="form-select" >
                            <option >New Priority</option>
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="" class="form-label">Category <span class="text-danger">*</span></label>
                        <select class="form-select" >
                            <option >New Category</option>
                            <option value="1">Member spotlight</option>
                            <option value="2">Industry Trends</option>
                            <option value="3">NMM Insider</option>
                            <option value="3">Other</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                            <label class="form-label">Date Only Picker <span class="text-danger">*</span></label>
                            <input class="result form-control" type="date" id="date" placeholder="Date Picker...">
                    </div>
                    <span class="text-danger">* (Image size must be 745x420)</span>
                    <div class="input-group mb-3">
                        <input type="file" class="form-control" id="inputGroupFile02">
                        <label class="input-group-text" for="inputGroupFile02">Upload </label>
                    </div>
                    <div class="col-md-12">
                        <label for="inputFirstName" class="form-label">Description <span class="text-danger">*</span></label>
                        <textarea id="elm1" name="area"></textarea>
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-primary ">Submit</button>
                    </div>
                </form>
            </div>
        </div>

	</div>
</div>	
