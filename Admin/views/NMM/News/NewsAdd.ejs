<%- contentFor('body') %>
<%- contentFor('body') %>

<div class="modal-content">
    <div class="modal-header">
        	<h4 class="card-title ">Add</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div class="card">
            <div class="card-body border border-1 rounded-3">
                <form class="row g-3 needs-validation form submit " action="<%=AdminRoute('/newsSave') %>" method="post" enctype="multipart/form-data" novalidate>
                    <div class="col-md-6">
                        <label for="inputTitle" class="form-label">Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="inputTitle"  placeholder="Title" name="title" required>
                        <div class="invalid-feedback">Please enter a Title.</div>
                    </div>
                    
                    <div class="col-md-6">
                        <label for="inputPriority" class="form-label">Priority <span class="text-danger">*</span></label>
                        <select class="form-select" id="inputPriority" name="priority" required>
                            <option>New Priority</option>  
                            <% for(let i = 1; i <= 5; i++) { %>
                                <option value="<%= i %>"><%= i %></option>
                            <% } %>
                        </select>
                        <div class="invalid-feedback">Please enter a Priority.</div>
                    </div>

                    <div class="col-md-6">
                        <label for="inputCategory" class="form-label">Category <span class="text-danger">*</span></label>
                        <select class="form-select"  name="category_id" required>
                            <option value="">New Category</option>
                            <% NewsAdd.forEach(category => { %>
                                <option value="<%= category.id %>"><%= category.type %></option>
                            <% }) %>
                        </select>
                        <div class="invalid-feedback">Please enter a Category.</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="inputDate">Date <span class="text-danger">*</span></label>
                        <input class="result form-control" type="date" id="inputDate" name="date" placeholder="Date" required>
                        <div class="invalid-feedback">Please enter a date.</div>
                    </div>

                    <span class="text-danger">* (Image size must be 745x420)</span>
                    <div class="input-group mb-3">
                        <input type="file" class="form-control" id="inputGroupFile02" name="image" required>
                        <label class="input-group-text" for="inputGroupFile02">Upload </label>
                        <div class="invalid-feedback">Please Upload a image.</div>
                    </div>

                    <div class="col-md-12">
                        <label for="inputDescription" class="form-label">Description <span class="text-danger">*</span></label>
                        <textarea id="elm1" name="description" required></textarea>
                        <div class="invalid-feedback">Please enter a Description.</div>
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-dark ">Submit</button>
                    </div>
                </form>
            </div>
        </div>

	</div>
</div>	
