
<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="text-center mb-3">
                    <h4><%= newsDetails.title %></h4>
                </div>
                <div class="mb-4">
                    <img class="img-thumbnail mx-auto d-block" style="width: 100%; height:320px; object-fit: cover" src="<%= newsDetails.image.replace('/thumb', '') %>">
                </div>
                <div class="text-center">
                    <div class="row">
                        <div class="col-sm-4">
                            <h6 class="mb-2">Categories</h6>
                            <p class="text-muted font-size-15"><%= newsDetails.type %></p>
                        </div>
                        <div class="col-sm-4">
                            <h6 class="mb-2">Date</h6>
                            <p class="text-muted font-size-15"><%= new Date(newsDetails.created_at * 1000).toLocaleString() %></p>
                        </div>
                        <div class="col-sm-4">
                            <p class="text-muted mb-2">Post by</p>
                            <h5 class="font-size-15">Admin</h5>
                        </div>
                    </div>
                </div>
                <hr>

                <div class="mt-4">
                    <h5 class="mb-3">Title</h5>
                    <blockquote class="p-4 border-light border rounded mb-4">
                        <div class="d-flex">
                            <div class="me-3">
                                <i class="bx bxs-quote-alt-left text-body font-size-24"></i>
                            </div>
                            <div id="newsDescription">
                                <p class="mb-0"><%- newsDetails.description %></p>
                            </div>
                        </div>
                    </blockquote>
                </div>
            </div> <!-- end card-body -->
        </div> <!-- end card -->
        <!-- end card -->
    </div>
    <!-- end col -->
    <div class="col-lg-4 ">
        <div class="row">
            <div class="card">
                <div class="card-body">
                    <div class="mt-5">
                        <h5 class="mb-3">Categories</h5>
                        
                        <ul class="list-unstyled fw-medium px-2">
                            <% category.forEach((category) => { %>
                            <li><a href="" class="text-body pb-4 d-block border-bottom"><%= category.category %><span class="badge bg-primary-subtle text-primary rounded-pill ms-1 float-end font-size-12"><%= category.count %></span></a></li>
                            <% }); %> 
                        </ul>
                        
                    </div>
                    
                </div>
            </div> <!-- end card -->
        </div>
    </div>
</div> 

