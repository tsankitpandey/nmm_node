<%- contentFor('body') %>
<section class="content">
	<div class="container-fluid">
		<div class="row">
			<div class="col-md-12">
				<div class="card card-theme card-outline shadow-sm">
					<div class="card-header">
						<h4 class="card-title mb-3">News List</h4>
					</div>

                    <div class="card-body">
                        <div class="row">
                            <div class="col-6 mb-4">
                                <button type="button" class="btn btn-sm btn-gradient-dark px-4 radius-30 float-left" data-route="<%= AdminRoute('/NewsAdd') %>" data-bs-toggle="modal" data-bs-target="#form-modal">
                                    <i class='bx bx-edit'></i>  ADD
                                </button>
                            </div>
                            <hr class="mb-3">
                            <div class="table-responsive mb-3">
                                <table  id="example2" class=" display table table-striped table-bordered mb-5">
                                    <thead class="mb-2 border-1">
                                        <tr>
                                            <th>Image</th>
                                            <th>Title</th>
                                            <th>Priority</th>
                                            <th>Category</th>
                                            <th>Date</th>
                                            <th>Description</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    <% if (NewsList && NewsList.length > 0) { %>
                                        <% NewsList.forEach(NewsList => { %>
                                        <tr>
                                            <td><img
                                            src="<%= NewsList.image %>"
                                            alt="image" style="width: 50px; height: 50px; object-fit: cover"/> </td>
                                            <td><%= NewsList.title %></td>
                                            <td><%= NewsList.priority %></td>
                                            <td><%= NewsList.type %> </td>
                                            <td><%= NewsList.date %></td>
                                            <td><%= NewsList.description %></td>
                                            
                                            <td>   
                                            <button class="btn btn-sm btn-gradient-success waves-effect px-4 radius-30 waves-light" data-route="<%= AdminRoute(`/NewsEdit?id=${NewsList.id}`) %>" data-bs-toggle="modal" data-bs-target="#form-modal"><i class='bx bx-edit'></i>edit
                                            </button>
                                            
                                            <a href="<%= AdminRoute(`/NewsDelete/${NewsList.id}`) %>" class="btn btn-sm btn-gradient-danger px-3 radius-30" onclick="return confirm('Are you sure you want to delete this News ?')"><i class='bx bxs-trash' ></i>Delete
                                            </a></td>
                                        </tr>
                                        <% }); %>
                                    <% }  %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
				</div>
			</div>
		</div>
	</div>
</section>

