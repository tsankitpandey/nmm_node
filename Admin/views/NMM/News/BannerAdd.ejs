<%- contentFor('body') %>
<%- contentFor('body') %>

<div class="modal-content">
    <div class="modal-header">
        	<h4 class="card-title ">Add</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div class="card">
            <div class="card-body border border-1 rounded-3">
                <form class="row g-3" method="">
                    <div class="col-md-12">
                        <label for="inputFirstName" class="form-label">Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="">
                    </div>
                    <div class="col-md-6">
                        <label for="" class="form-label">Priority <span class="text-danger">*</span></label>
                        <select class="form-select" >
                            <option >New Priority</option>
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="" class="form-label">Display banner's title, description, button <span class="text-danger">*</span></label>
                        <div class="form-check">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="option1">
                                <label class="form-check-label" for="inlineRadio1">On</label>
                              </div>
                              <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio2" value="option2">
                                <label class="form-check-label" for="inlineRadio2">Off</label>
                              </div> 
                          </div>
                    </div>
                    <div class="col-md-6">
                        <label for="" class="form-label">Category <span class="text-danger">*</span></label>
                        <select class="form-select" >
                            <option >New Category</option>
                            <option value="1">Member spotlight</option>
                            <option value="2">Industry Trends</option>
                            <option value="3">NMM Insider</option>
                            <option value="3">Other</option>
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <div class="form-collapse">
                            <div class="form-row">
                                <div class="col-md-12">
                                    <label class="mb-2">Button Link <span class="text-danger">*</span></label>
                    
                                    <ul class="nav nav-pills">
                                        <li class="nav-item">
                                            <a href="#" class="nav-link button-collapse border shadow mr-2" 
                                               data-bs-toggle="collapse" data-bs-target="#collapse1" onclick="toggleCollapse('collapse1', 'collapse2')">Popup</a>
                                        </li>
                    
                                        <li class="nav-item mx-2">
                                            <a href="#" class="nav-link button-collapse border shadow" 
                                               data-bs-toggle="collapse" data-bs-target="#collapse2" data-tooltip="Add URL with https://"
                                               onclick="toggleCollapse('collapse2', 'collapse1')">URL</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                    
                            <div class="collapse mt-3" id="collapse1">
                                <div class="col-md-12 d-none">
                                    <input type="text" class="form-control" name="banner[popup]" value="1" placeholder="Popup">
                                </div>
                            </div>
                    
                            <div class="collapse mt-3" id="collapse2">
                                <div class="col-md-12">
                                    <input type="text" class="form-control" name="banner[button_link]" value="" placeholder="https://">
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-12">
                        <label for="" class="form-label">Description <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="">
                    </div>
                    <span class="text-danger"> * (Image size must be 1300x200)</span> 
                    <div class="input-group mb-3">
                        <input type="file" class="form-control" id="inputGroupFile02">
                        <label class="input-group-text" for="inputGroupFile02">Upload</label>
                    </div>
                    
                    <div class="col-md-6">
                        <label for="inputFirstName" class="form-label">Content </label>
                        <form method="post">
							<textarea id="mytextarea" name="mytextarea"></textarea>
						</form>
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-dark">Submit</button>
                    </div>
                </form>
            </div>
        </div>

	</div>
</div>	

<script>
    function toggleCollapse(showId, hideId) {
        let showElement = document.getElementById(showId);
        let hideElement = document.getElementById(hideId);

        if (showElement.classList.contains("show")) {
            
            bootstrap.Collapse.getInstance(showElement).hide();
        } else {
        
            bootstrap.Collapse.getOrCreateInstance(showElement).show();
            bootstrap.Collapse.getInstance(hideElement)?.hide();
        }
    }
</script>