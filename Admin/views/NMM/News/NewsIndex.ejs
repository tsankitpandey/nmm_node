
<div class="row row-cols-1 row-cols-lg-2 row-cols-xl-2">
    <div class="col-xl-12">
        <h2 class="mb-0 ">What's New</h2>
        <hr/>
         <!-- <pre><%= JSON.stringify(NewsIndex,null,2) %></pre> -->
        <div class="card">
            <div class="card-body">
                <div id="carouselExampleSlidesOnly" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner mb-3">
                        <% if (NewsIndex.banners && NewsIndex.banners.length > 0) { %>
                            <% NewsIndex.banners.forEach((newsItem) => { %>
                                <div class="carousel-item active">
                                    <img src="<%= newsItem.image.replace('/thumb', '') %>" class="d-block" 
                                        style="width: 100%; height: 200px; object-fit: cover" 
                                        alt="News Image">
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p>No news available.</p>
                        <% } %>
                    </div>
                </div>
                          

                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4 mb-4">
                <div class="col-md-12">
                    <h2 class="">Insights</h2>
                    <hr />
                </div>
                <% if (NewsIndex.news && NewsIndex.news.length > 0) { %>
                    <% let counter = 0; %>
                    <% NewsIndex.news.forEach((item) => { %>
                        <% if (counter >= 6) return; %>
                        <% 
                        let description = item.description.split(' '); 
                        let short_desc = description.slice(0, 20).join(' '); 
                        let title_word = item.title.split(' '); 
                        let short_title = title_word.slice(0, 2).join(' '); 
                        if (title_word.length > 2) short_title += '...'; 
                        %>
                
                        <div class="col">
                            <div class="card rounded-4 overflow-hidden bg-gradient-moonlit" style="height: 450px; display: flex; flex-direction: column;">
                                <div class="card-body text-white d-flex flex-column overflow-auto">
                                    <img src="<%= item.image.replace('/thumb', '') %>" class="img-fluid rounded-4" 
                                        style="width: 100%; height: 200px; object-fit: cover;" alt="News Image">  
                                    <div class="d-flex align-items-center gap-4 mt-4">
                                        <div class="posted-date">
                                            <p class="mb-0"><i class="bx bx-calendar-alt me-2"></i>
                                                <%= new Date(item.created_at * 1000).toLocaleString() %>
                                            </p>
                                        </div>
                                    </div>
                                    <h5 class="card-title mt-3 text-white"><%= short_title %></h5>
                                    <div class="mb-0 flex-grow-1 text-truncate-clamp">
                                        <%- short_desc + (description.length > 20 ? '...' : '') %>
                                    </div>
                                    <div class="form-row ">
                                        <a href="<%= AdminRoute(`/details?id=${item.id}`) %>" class="btn btn-light btn-ecomm mb-3 rounded-4 px-4">Read More</a>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                        <% counter++; %>
                    <% }); %>
                <% } else { %>
                    <p>No news available.</p>
                <% } %>                
                </div><!--end row-->
                <div class="row justify-content-center mb-4">
                    <div class="col-md-3">
                        <div class="" style="text-align: center;">
                            <a href="<%= AdminRoute(`/All`); %>" class="btn btn-sm btn-gradient-dark px-4 radius-30">View All</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>