<%
const news_data = NewsAll;
const item_per_page = 6;

const page = (typeof current_page !== "undefined" && current_page) ? current_page : 1;

const total_news = Array.isArray(news_data) ? news_data.length : 0;
const total_pages = Math.ceil(total_news / item_per_page);
const offset = (page - 1) * item_per_page;
const current_page_news = news_data.slice(offset, offset + item_per_page);
%>


<div class="row">
    <div class="row align-items-center">
        <div class="col-md-6">
            <div class="mb-3">
                <h5 class="card-title">News List <span class="text-muted fw-normal ms-2"></span></h5>
            </div>
        </div>
    <!-- some -->
    </div>
    <!-- end row -->

     <div class="row">
        <div class="col-xl-8">
            <% NewsAll.forEach((item) => { %>
                <div class="card">
                    <%
                    let description = item.description.split(' ');
                    let short_desc = description.slice(0, 20).join(' ');
                    %>
                    <img class="card-img img-fluid w-100 card-img-fit" style="height:250px;" src="<%= item.image.replace('/thumb', ''); %>">
                    <div class="card-body">
                        <p class="text-muted mb-2"><%= new Date(item.created_at * 1000).toLocaleString() %></p>
                        <h5 class=""><a href="#" class="text-body"><%= item.title %></a></h5>
                        <p class="mb-0 " style="font-size:10px;"><%- short_desc + (description.length > 20 ? '...' : '') %></p>
                        <div class="mt-3">
                            <a href="<%= AdminRoute(`/details?id=${item.id}`) %>" class="align-middle " style="font-size:medium;">Read more <i class="mdi mdi-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
            <% }); %> 
        </div>
        <!--end col-->

        <div class="col-lg-4 ">
            <div class="row">
                <div class="card">
                    <div class="card-body">
                        <div class="mt-5">
                            <h5 class="mb-3">Categories</h5>
                            
                            <ul class="list-unstyled fw-medium px-2">
                                <% category.forEach((category) => { %>
                                <li><a href="" class="text-body pb-4 d-block border-bottom"><%= category.category %><span class="badge bg-primary-subtle text-primary rounded-pill ms-1 float-end font-size-12"><%= category.count %></span></a></li>
                                <% }); %> 
                            </ul>
                            
                        </div>
                        
                    </div>
                </div> <!-- end card -->
            </div>
        </div>
    </div>
    <!--end row-->

    <div class="row justify-content-center mb-4">
        <div class="col-md-3">
            <div class="">
                <ul class="pagination mb-sm-0">
                    <li class="page-item <%= (current_page === 1) ? 'disabled' : '' %>">
                        <a href="?page=<%= Math.max(1, current_page - 1) %>" class="page-link">
                            <i class='bx bx-chevron-left'></i>
                        </a>
                    </li>
                    <% if (total_pages > 0) { %>
                        <% for (let i = 1; i <= total_pages; i++) { %>
                            <li class="page-item <%= i === current_page ? 'active' : '' %>">
                                <a href="?page=<%= i %>" class="page-link"><%= i %></a>
                            </li>
                        <% } %>
                    <% } %>
                    <li class="page-item <%= (current_page === total_pages) ? 'disabled' : '' %>">
                        <a href="?page=<%= Math.min(total_pages, current_page + 1) %>" class="page-link">
                            <i class='bx bx-chevron-right' ></i>
                        </a>
                    </li>
    
                </ul>
            </div>
        </div>
    </div>
    
    
    <!-- end row -->
</div>