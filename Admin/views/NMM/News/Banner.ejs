<%- contentFor('body') %>
<section class="content">
	<div class="container-fluid">
		<div class="row">
			<div class="col-md-12">
				<div class="card card-theme card-outline shadow-sm">
					<div class="card-header">
						<h4 class="card-title mb-3">Banner List</h4>
					</div>
					
                    <div class="card-body border-bottom">
    					<div class="row">
        					<div class="col-6 mb-3">
        						<button type="button" class="btn btn-sm btn-gradient-dark px-4 radius-30 float-left" data-route="<%= AdminRoute('/BannerAdd') %>" data-bs-toggle="modal" data-bs-target="#form-modal">
        						    <i class='bx bx-edit'></i>  ADD
        						</button>
						    </div>
						</div>
        			</div>
     
                    <div class="table-responsive mb-3">
                        <table  id="example2" class=" display table table-striped table-bordered mb-5">
                            <thead class="mb-2 border-1">
                                <tr>
                                    <th>Image</th>
                                    <th>Title</th>
                                    <th>Priority</th>
                                    <th>Button text</th>
                                    <th>Button link</th>
                                    <th>Description</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            <% if (banner && banner.length > 0) { %>
                                <% banner.forEach(banner => { %>
                                <tr>
                                    <td><img
                                    src="<%= banner.image %>"
                                    alt="image" style="width: 50px; height: 50px; object-fit: cover"/> </td>
                                    <td><%= banner.title %></td>
                                    <td><%= banner.priority %></td>
                                    <td><%= banner.button_text %> </td>
                                    <td><%= banner.button_link %></td>
                                    <td><%= banner.description %></td>
                                    
                                    <td>   
                                    <button class="btn btn-sm btn-gradient-success waves-effect px-4 radius-30 waves-light" data-route="<%= AdminRoute(`/bannerEdit?id=${banner.id}`) %>" data-bs-toggle="modal" data-bs-target="#form-modal"><i class='bx bx-edit'></i>edit
                                    </button>
                                    
                                    <a href="<%= AdminRoute(`/bannerDelete?id=${banner.id}`) %>" class="btn btn-sm btn-gradient-danger px-3 radius-30" onclick="return confirm('Are you sure you want to delete this banner ?')"><i class='bx bxs-trash' ></i>Delete
                                    </a></td>
                                </tr>
                                <% }); %>
                            <% }  %>
                            </tbody>
                        </table>
                    </div>
				</div>
			</div>
		</div>
	</div>
</section>
