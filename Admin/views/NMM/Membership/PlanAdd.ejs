<%- contentFor('body') %> <%- contentFor('body') %>

<div class="modal-content">
  <div class="modal-header">
    <h4 class="card-title">Membership Plan</h4>
    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="modal"
      aria-label="Close"
    ></button>
  </div>
  <div class="modal-body">
    <div class="card">
      <div class="card-body border border-1 rounded-3">
        <form
          class="needs-validation"
          action="<%=AdminRoute( '/planinsert' )%>"
          method="POST"
          enctype="multipart/form-data"
          novalidate
        >
          <input type="hidden" />
          <div class="row">
            <div class="col-xl-6 col-md-6">
              <div class="form-group">
                <label class="mb-2"
                  >MemberShip Name <span class="text-danger">*</span></label
                >
                <input
                  type="text"
                  name="membership_plans[membership_name]"
                  class="form-control"
                  placeholder="MemberShip Name"
                  required
                />
                <div class="invalid-feedback">
                  Please enter membership name.
                </div>
              </div>
            </div>

            <div class="col-xl-6 col-md-6">
              <div class="form-group">
                <label class="mb-2"
                  >Duration in Month <span class="text-danger">*</span></label
                >
                <input
                  type="number"
                  class="form-control"
                  name="membership_plans[duration_in_months]"
                  placeholder="Month"
                  required
                />
                <div class="invalid-feedback">Please enter duration.</div>
              </div>
            </div>

            <div class="col-xl-6 col-md-6">
              <div class="form-group">
                <label class="mb-2 mt-2"
                  >Fees<span class="text-danger">*</span></label
                >
                <input
                  type="text"
                  class="form-control"
                  name="membership_plans[fees]"
                  value=""
                  placeholder="Fees"
                  required
                />
                <div class="invalid-feedback">Please enter Fees.</div>
              </div>
            </div>

            <div class="col-xl-6 col-md-6">
              <div class="form-group">
                <label class="mt-2"
                  >Status <span class="text-danger">*</span></label
                >
                <div class="radio-box form-check-inline">
                  <input
                    type="radio"
                    class="form-check-input input-collapse mx-1 text-theme"
                    name="membership_plans[status]"
                    value="0"
                    placeholder="Active"
                    data-collapse="hide"
                    checked
                  />
                  <label class="form-check-label">Activate</label>
                </div>
                <div class="radio-box form-check-inline">
                  <input
                    type="radio"
                    class="form-check-input input-collapse mx-1 text-theme"
                    name="membership_plans[status]"
                    value="1"
                    placeholder="Inactive"
                    data-collapse="hide"
                  />
                  <label class="form-check-label">Deactivate</label>
                </div>
              </div>
            </div>

            <div class="col-xl-12 col-md-6">
              <div class="form-group mb-3">
                <label class="mb-2"
                  >Description <span class="text-danger">*</span></label
                >
                <textarea id="elm1" name="area" required></textarea>
                <div class="invalid-feedback">Please enter Description.</div>
              </div>
            </div>
          </div>

          <div class="col-xl-8 col-md-6">
            <div class="form-group mb-3">
              <label>Gallery Access</label> &nbsp; &nbsp; &nbsp;
              <div class="form-check form-check-inline">
                <input
                  type="radio"
                  class="form-check-input"
                  name="gallery_access"
                  id="upload-yes"
                  value="1"
                  onclick="toggleUnlimited(true);"
                  checked
                />
                <label class="form-check-label" for="upload-yes">Yes</label>
              </div>
              <div class="form-check form-check-inline">
                <input
                  type="radio"
                  class="form-check-input"
                  name="gallery_access"
                  id="upload-no"
                  value="0"
                  onclick="toggleUnlimited(false);"
                />
                <label class="form-check-label" for="upload-no">No</label>
              </div>
            </div>

            <!-- Unlimited Access -->
            <div class="form-group mb-3 collapse show" id="upload-unlimited">
              <label> Unlimited Access </label> &nbsp; &nbsp; &nbsp;
              <div class="form-check form-check-inline">
                <input
                  type="radio"
                  class="form-check-input"
                  name="Gallery_unlimited_access"
                  id="unlimited-yes"
                  value="1"
                  onclick="toggleUploadExtra(false);"
                  checked
                />
                <label class="form-check-label" for="unlimited-yes">Yes</label>
              </div>
              <div class="form-check form-check-inline">
                <input
                  type="radio"
                  class="form-check-input"
                  name="Gallery_unlimited_access"
                  id="unlimited-no"
                  value="0"
                  onclick="toggleUploadExtra(true);"
                />
                <label class="form-check-label" for="unlimited-no">No</label>
              </div>
            </div>

            <!-- Upload Extra Section -->
            <div class="collapse " id="upload-extra">
              <div class="col-xl-7 mb-3">
                <label
                  for="upload-extra-photo"
                  class="d-flex align-items-center"
                  >Upload Extra Photo
                  <input
                    type="number"
                    class="form-control ms-2"
                    id="upload-extra-photo"
                    name="upload_photo"
                    placeholder="Enter Upload Extra Photo"
                  />
                </label>
              </div>
              <div class="col-xl-7 mb-3">
                <label
                  for="upload-extra-video"
                  class="d-flex align-items-center"
                  >Upload Extra Video
                  <input
                    type="number"
                    class="form-control ms-2"
                    id="upload-extra-video"
                    name="upload_video"
                    placeholder="Enter Upload Extra Video"
                  />
                </label>
              </div>
            </div>
          </div>

          <div class="col-xl-9 col-md-6">
            <div class="form-group mb-3">
              <label
                >View Personal Contact on Other Profiles
                <span class="text-danger"></span></label
              >&nbsp; &nbsp;
              <div class="form-check form-check-inline">
                <input
                  type="radio"
                  class="form-check-input"
                  name="membership_plans[personal_contact_details]"
                  value="1"
                  checked
                />
                <label class="form-check-label">Yes</label>
              </div>
              <div class="form-check form-check-inline">
                <input
                  type="radio"
                  class="form-check-input"
                  name="membership_plans[personal_contact_details]"
                  value="0"
                />
                <label class="form-check-label">No</label>
              </div>
            </div>
          </div>

          <div class="col-xl-6 col-md-6">
            <div class="form-group mb-3">
              <label>Mobile Access <span class="text-danger"></span></label>
              &nbsp; &nbsp;
              <div class="form-check form-check-inline">
                <input
                  type="radio"
                  class="form-check-input"
                  name="membership_plans[mobile_access]"
                  value="1"
                  checked
                />
                <label class="form-check-label">Yes</label>
              </div>
              <div class="form-check form-check-inline">
                <input
                  type="radio"
                  class="form-check-input"
                  name="membership_plans[mobile_access]"
                  value="0"
                />
                <label class="form-check-label">No</label>
              </div>
            </div>
          </div>

          <div class="col-xl-6 col-md-6">
            <div class="form-group mb-3">
              <label>Attend Events <span class="text-danger"></span></label>
              &nbsp; &nbsp;
              <div class="form-check form-check-inline">
                <input
                  type="radio"
                  class="form-check-input"
                  name="membership_plans[attend_event]"
                  value="1"
                  checked
                />
                <label class="form-check-label">Yes</label>
              </div>
              <div class="form-check form-check-inline">
                <input
                  type="radio"
                  class="form-check-input"
                  name="membership_plans[attend_event]"
                  value="0"
                />
                <label class="form-check-label">No</label>
              </div>
            </div>
          </div>

          <div class="col-xl-10 col-md-6">
            <div class="form-group mb-3">
              <label>Extra Contact <span class="text-danger"></span></label>
              &nbsp; &nbsp;
              <div class="form-check form-check-inline">
                <input
                  type="radio"
                  class="form-check-input"
                  name="membership_plans[extra_contact]"
                  id="extra-yes"
                  value="1"
                  onclick="toggleExtraLimits(true);"
                  checked
                />
                <label class="form-check-label" for="extra-yes">Yes</label>
              </div>
              <div class="form-check form-check-inline">
                <input
                  type="radio"
                  class="form-check-input"
                  name="membership_plans[extra_contact]"
                  id="extra-no"
                  value="0"
                  onclick="toggleExtraLimits(false);"
                />
                <label class="form-check-label" for="feed-no">No</label>
              </div>
            </div>
            <div id="extra-limits" class="collapse show">
              <div class="col-xl-6 mb-3">
                <label for="extra-per-week" class="d-flex align-items-center"
                  >Extra Contact limit
                  <input
                    type="number"
                    class="form-control mx-3"
                    id="extra-per-week"
                    name="membership_plans[extra_contact_limit]"
                    placeholder="Enter weekly extra limit"
                /></label>
              </div>
            </div>
          </div>

          <div class="col-xl-8 col-md-6">
            <div class="form-group mb-3">
                <label>Feed Access</label> &nbsp; &nbsp; &nbsp;
                <div class="form-check form-check-inline">
                    <input
                        type="radio"
                        class="form-check-input"
                        name="membership_plans[post_access]"
                        id="feed-yes"
                        value="1"
                        onclick="toggleUnlimitedAccess(true);"
                        checked
                    />
                    <label class="form-check-label" for="feed-yes">Yes</label>
                </div>
                <div class="form-check form-check-inline">
                    <input
                        type="radio"
                        class="form-check-input"
                        name="membership_plans[post_access]"
                        id="feed-no"
                        value="0"
                        onclick="toggleUnlimitedAccess(false);"
                    />
                    <label class="form-check-label" for="feed-no">No</label>
                </div>
            </div>
            
           
            <div id="unlimited-access" class="form-group mb-3">
                <label>Unlimited Access</label> &nbsp; &nbsp; &nbsp;
                <div class="form-check form-check-inline">
                    <input
                        type="radio"
                        class="form-check-input"
                        name="membership_plans[unlimited_access]"
                        id="unlimited-yes"
                        value="1"
                        onclick="toggleFeedLimits(false);"

                        checked
                    />
                    <label class="form-check-label" for="unlimited-yes">Yes</label>
                </div>
                <div class="form-check form-check-inline">
                    <input
                        type="radio"
                        class="form-check-input"
                        name="membership_plans[unlimited_access]"
                        id="unlimited-no"
                        value="0"
                        onclick="toggleFeedLimits(true);"

                    />
                    <label class="form-check-label" for="unlimited-no">No</label>
                </div>
            </div>
            

            <div id="feed-limits" class="d-none">

              <div class="col-xl-7 mb-3">
                <label for="feed-per-week" class="d-flex align-items-center"
                  >Feed per week limit
                  <input
                    type="number"
                    class="form-control"
                    id="feed-per-week"
                    name="membership_plans[post_per_weak]"
                    placeholder="Enter weekly feed limit"
                /></label>
              </div>
              <div class="col-xl-7 mb-3">
                <label for="feed-total" class="d-flex align-items-center"
                  >Feed total limit &nbsp;
                  <input
                    type="number"
                    class="form-control ms-2"
                    id="feed-total"
                    name="membership_plans[feeds_upload]"
                    placeholder="Enter total feed limit"
                /></label>
              </div>
            </div>
          </div>

          <!-- <div class="col-xl-6 col-md-6">
            <div class="form-group mb-3">
              <label
                >Branch Office Access <span class="text-danger"></span
              ></label>
              &nbsp; &nbsp; &nbsp;

              <div class="form-check form-check-inline">
