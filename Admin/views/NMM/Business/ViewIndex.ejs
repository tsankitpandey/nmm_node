<%- contentFor('body') %>
<section class="content">
	<div class="container-fluid">
		<div class="row">
			<div class="col-md-12">
				<div class="card card-theme card-outline shadow-sm">
					<div class="card-header">
						<h4 class="card-title mb-3 mb-3">User Business Wallet List</h4>
					</div>

                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="example" class="table table-striped table-bordered" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Company Name</th>
                                        <th>Business Impact Amount</th>          
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (ViewIndex && ViewIndex.length> 0) { %>
                                        <% ViewIndex.forEach(ViewIndex=> { %>
                                    <tr>
                                        <td><%= ViewIndex.company_name %></td>
                                        <td><%= ViewIndex.wallet_balance %></td>
                                        <td><button class="btn btn-sm btn-warning waves-effect waves-light text-light"
                                            data-route="<%= AdminRoute(`/ViewModel?id=${ViewIndex.receiver_id}`) %>"
                                            data-bs-toggle="modal"
                                            data-bs-target="#form-modal">
                                            <i class='bx bx-low-vision'></i>
                                        </button></td>
                                    </tr>
                                    <% }); %>
                                     <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center">No
                                            Active Member found.</td>
                                    </tr>
                                    <% } %>
                            </tbody>        
                            </table>
                        </div>
                    </div>
				</div>
			</div>
		</div>
	</div>
</section>
