<%- contentFor('body') %>


<div class="modal-content ">
    <div class="modal-header">
        	<!-- <h4 class="card-title ">Add</h4> -->
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body ">
        <div class="card">
            <div class="card-body border border-1 rounded-3">
                <form action="" method="post" enctype="multipart/form-data" data-parsley-validate>
                    <div class="card card-teal card-outline shadow-sm">
                        
                       
                            <!-- <pre><%= JSON.stringify(ViewModels, null, 2) %></pre> -->
                            <div class="table-responsive">
                                <div class="table ">
                                    <table id="example" class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Sender</th>          
                                                <th>Receiver</th>
                                                <th>Amount ($)</th>
                                                <th>Status</th>          
                                                <th>Date</th>
                                                <th>Final Business Wallet ($)</th>          
                                                <th>Comment</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% let i = 0; %>
                                            <% if (ViewModels && ViewModels.length > 0) { %>
                                                <% ViewModels.forEach(ViewIndex => { %>
                                                    <tr>
                                                        <td><%= ++i %></td> 
                                                        
                                                        <% if (ViewIndex.receiver_id === ViewIndex.sender_id) { %>
                                                            <td><%= ViewIndex.sender_company_name %></td>
                                                            <td><%= ViewIndex.receiver_company_name %></td>
                                                            <td><%= '$' + ViewIndex.amount %></td>
                                                            <td><%= ViewIndex.status %></td>
                                                            <td><%= new Date(ViewIndex.created_at * 1000).toLocaleDateString() %></td>
                                                            <td><%= '$' + ViewIndex.sender_final_wallet %></td>
                                                            <td><%= ViewIndex.admin_comment ? ViewIndex.admin_comment : ViewIndex.member_comment %></td>
                                                        <% } else { %>
                                                            <td><%= ViewIndex.sender_company_name %></td>
                                                            <td><%= ViewIndex.receiver_company_name %></td>
                                                            <td><%= '$' + ViewIndex.amount %></td>
                                                            <td><%= ViewIndex.status %></td>
                                                            <td><%= new Date(ViewIndex.created_at * 1000).toLocaleDateString() %></td>
                                                            <td><%= '$' + ViewIndex.receiver_final_wallet %></td>
                                                            <td><%= ViewIndex.admin_comment ? ViewIndex.admin_comment : ViewIndex.member_comment %></td>
                                                        <% } %>
                                                    </tr>
                                                <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="8" class="text-center">No Active Member found.</td> 
                                                </tr>
                                            <% } %>
                                        </tbody>        
                                    </table>
                                    
                                </div>
                            </div>
                        
                        
                    </div>
                </form>
            </div>
        </div>

	</div>
</div>	
