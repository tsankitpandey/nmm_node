<%- contentFor('body') %>
<section class="content">
	<div class="container-fluid">
		<div class="row">
			<div class="col-md-12">
				<div class="card card-theme card-outline shadow-sm">
					<div class="card-header">
						<h4 class="card-title mb-3 mb-3">User Business Wallet List</h4>
					</div>

                    <div class="card-body">
                        <form class="g-3" method="">
                            <div class="row ">
                            <div class="col-md-6 mb-3">
                                <label for="inputFirstName" class="form-label">To Company Name <span class="text-danger">*</span></label>
                                <select class="form-select" >
                                    <option >Company name</option>
                                    <option value="">Logistic</option>
                                    <option value="">Techsimba</option>
                                    
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="" class="form-label">From Company Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="" class="form-label">Transaction Mode: <span class="text-danger">*</span></label>
                                <select class="form-select" >
                                    <option >select Transaction Mode</option>
                                    <option value="1">online</option>
                                    <option value="0">offline</option>
                                    
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="" class="form-label">Amount <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Transaction Date <span class="text-danger">*</span></label>
                                <input class="result form-control" type="date" id="date" placeholder="Date">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="" class="form-label">Comment<span class="text-danger">*</span></label>
                                <textarea type="text" class="form-control" id=""></textarea>
                            </div>
                        </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-dark ">Submit</button>
                    </div>
                        </form>
                    </div>
				</div>
			</div>
		</div>
	</div>
</section>
