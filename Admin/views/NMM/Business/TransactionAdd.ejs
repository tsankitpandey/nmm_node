<%- contentFor('body') %>

<style>
    .selected {
        color: grey;
    }
</style>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-theme card-outline shadow-sm">
                    <div class="card-header">
                        <h4 class="card-title mb-3">Member to Member Transaction</h4>
                    </div>

                    <div class="card-body">
                        <form class="g-3 needs-validation form-submit" action="<%=AdminRoute('/Save') %>" method="post" enctype="multipart/form-data" novalidate>
                            <div class="row">
                                
                                
                                <div class="col-md-6 mb-3">
                                    <label for="inputToCompany" class="form-label">
                                        To Company Name <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select" id="inputToCompany" name="receiver_id" style="color: grey;" required>
                                        <option value="" class="selected">Company name</option>
                                        <% Transaction.company.forEach(company => { %>
                                            <option value="<%= company.company_id %>"><%= company.company_name %></option>
                                        <% }) %>
                                    </select>
                                    <div class="invalid-feedback">Please enter a Company</div>
                                </div>

                                
                                <div class="col-md-6 mb-3">
                                    <label for="inputFromCompany" class="form-label">
                                        From Company Name <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select" id="inputFromCompany" name="sender_id" style="color: grey;" required>
                                        <option value="" class="selected">Company name</option>
                                        <% Transaction.from_company.forEach(from_company => { %>
                                            <option value="<%= from_company.company_id %>"><%= from_company.company_name %></option>
                                        <% }) %>
                                    </select>
                                    <div class="invalid-feedback">Please enter a Company</div>
                                </div>

                               
                                <div class="col-md-6 mb-3">
                                    <label for="inputTransaction" class="form-label">
                                        Transaction Mode <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select" id="inputTransaction" name="transaction_mode" style="color: grey;" required>
                                        <option value="" class="selected">Select Transaction Mode</option>
                                        <option value="online">Online</option>
                                        <option value="offline">Offline</option>
                                    </select>
                                    <div class="invalid-feedback">Please enter a Transaction mode.</div>
                                </div>

                                
                                <div class="col-md-6 mb-3">
                                    <label for="inputAmount" class="form-label">
                                        Amount <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" name="amount" class="form-control" id="inputAmount" placeholder="Amount" required>
                                    <div class="invalid-feedback">Please enter an amount.</div>
                                </div>

                                
                                <div class="col-md-6 mb-3">
                                    <label for="inputDate" class="form-label">
                                        Transaction Date <span class="text-danger">*</span>
                                    </label>
                                    <input class="result form-control" type="date" id="inputDate" name="transaction_date" placeholder="Date" style="color: grey;" required>
                                    <div class="invalid-feedback">Please enter a date.</div>
                                </div>

                              
                                <div class="col-md-6 mb-3">
                                    <label for="InputComment" class="form-label">
                                        Comment <span class="text-danger">*</span>
                                    </label>
                                    <textarea name="admin_comment" class="result form-control" id="InputComment" placeholder="Comment" required></textarea>
                                    <div class="invalid-feedback">Please enter a comment.</div>
                                </div>
                                <input type="hidden" class="form-control" name="status" value="m2m">
                            </div>

                           
                            <div class="col-12">
                                <button type="submit" class="btn btn-dark float-end">Submit</button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
