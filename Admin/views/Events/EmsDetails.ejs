<%- contentFor('body') %>
<section class="content">
	<div class="container-fluid">
		<div class="row">
			<div class="col-md-12">
				<div class="card card-theme card-outline shadow-sm">
					<div class="card-header">
						<h4 class="card-title">Ems Details</h4>
						
					</div>
					
                    <div class="card-body border-bottom">
    					<div class="row">
        					<div class="col-6">
								<button type="button" class="btn btn-gradient-dark px-4 radius-30 float-left" data-route="<%= AdminRoute('/EmsAdd') %>" data-bs-toggle="modal" data-bs-target="#form-modal">
        						    <i class='bx bx-edit'></i> ADD
        						</button>
						    </div>
						</div>
        			</div>
                    <!-- <%=JSON.stringify(Ems)%> -->
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="example" class="table table-striped table-bordered" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Purpose</th>
                                        <th>Description</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <%Ems.data.forEach((item, index) => { %>
                                        <tr>
                                            <td><%= index + 1 %></td>
                                            <td><%= item.purpose %></td>
                                            <td><%= item.message.split(" ").slice(0, 10).join(" ") + (item.message.split(" ").length > 10 ? "..." : "") %></td>

                                            <td>
                                                <button class="btn btn-sm btn-primary" data-route="<%= AdminRoute('/editEms/' + item.id) %>"
                                                  data-bs-toggle="modal" data-bs-target="#form-modal">Edit</button>
                                                <a class="btn btn-sm btn-danger " href="<%= AdminRoute('/EmsDelete/' + item.id) %>"
                                                 >Delete</a> 
                                              </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    
                    
				</div>
			</div>
		</div>
	</div>
</section>
