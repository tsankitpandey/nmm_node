<%- contentFor('body') %>
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card border-top border-0 border-4 border-primary">
                    <div class="card-body p-5">
                        <div class="card-title d-flex align-items-center">
                            <div></div>
                            <h5 class="mb-0 text-primary">Event Information</h5>
                        </div>
                        <hr>
                        <form action="<%=AdminRoute('/EventSave') %>" class="row g-3 needs-validation form-submit" method="post" enctype="multipart/form-data" novalidate>
                            <div class="col-md-6">
                            <label for="inputLastName" class="form-label">Event Short Name <span class="text-red">*</span></label>
                            <input type="text" class="form-control" id="inputLastName" name="short_name"/ required>
                            <div class="invalid-feedback">Please enter Event Title.</div>
                            </div>
                            <div class="col-md-6">
                            <label for="inputLastName" class="form-label">Event Title <span class="text-red">*</span></label>
                            <input type="text" class="form-control" id="inputLastName" name="name" required>
                            <div class="invalid-feedback">Please enter Event Title.</div>
                            </div>
                            <div class="col-md-6">
                            <div class="form-group mb-3">
                            <label>Event Image <span class="text-red">* <span class="text-xs" data-tooltip="You'll need to ensure that the file you're trying to upload is in one of these formats (JPG, PNG, JPEG)">(Only jpg/png/jpeg files are allowed)</span></span></label>
                            <div class="form-file">
                            <input type="file" class="form-control form-file-input" name="image" value="" placeholder="Event Image" id="form-file" view="preview" required>
                            <label class="form-file-label"></label>
                            </div>
                            <div class="invalid-feedback">Please upload image.</div>
                            </div>
                            <!-- <label>Event Image <span class="text-red">* <span class="text-xs" data-tooltip="You'll need to ensure that the file you're trying to upload is in one of these formats (JPG, PNG, JPEG)">(Only jpg/png/jpeg files are allowed)</span></span></label>
                            <div class="form-file">
                            <input type="file" class="form-control form-file-input" name="event[image]" value="" placeholder="Event Image">
                            <label class="form-file-label"></label>
                            </div> -->
                            </div> 
                            <div class="col-md-6">
                            <label for="inputLastName" class="form-label">Event Theme <span class="text-red">*</span></label>
                            <input type="text" class="form-control" id="inputLastName">
                            </div> 
                            <div class="col-12">
                            <label for="inputAddress" class="form-label">Description</label>
                            <textarea class="form-control" id="inputAddress" name="description" placeholder="Address..." rows="3"></textarea>
                            </div>
                            <div class="col-md-4" >
                            <div class="mb-3 select2-sm select-country" data-route="<%=AdminRoute('/countrylist') %>">
                            <label class="form-label">Client Country</label>
                            <select class="single-select" name="country" required>
                            </select>
                            <div class="invalid-feedback">Please select Country.</div>
                            </div>
                            </div> 
                            <div class="col-md-4">

                                <div class="mb-3 select2-sm select-city" data-route="<%=AdminRoute('/citylist') %>">
                                    <label class="form-label">Client City</label>
                                    <select class="single-city-select" name="city" required>
                                    </select>
                                    <div class="invalid-feedback">Please select City.</div>
                                </div>

                            </div>
                            <div class="col-md-4">
                                <div class="mb-3 select2-sm select-timezone" data-route="<%=AdminRoute('/timezone') %>">
                                    <label class="form-label">TimeZone</label>
                                    <select class="single-timezone-select" name="TimeZone" required>
                                    </select>
                                    <div class="invalid-feedback">Please select TimeZone.</div>
                                </div>
                            
                            </div>
                            <div class="col-md-6">
                            <label for="inputstartdate" class="form-label">Event Start Date <span class="text-red">*</span></label>
                            <input type="date" class="form-control" id="inputstartdate" name="start_time"required>
                            
                            <div class="invalid-feedback">Please Select Start Date.</div>
                            </div> 
                            <div class="col-md-6">
                            <label for="inputenddate" class="form-label">Event End Date <span class="text-red">*</span></label>
                            <input type="date" class="form-control" id="inputenddate" name="end_time"required>
                            
                            <div class="invalid-feedback">Please Select End Date.</div>
                            </div> 
                            <div class="col-12">
                            <button type="submit" class="btn btn-primary px-5">Submit</button>
                            </div>
                            </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
